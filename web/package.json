{
    "name": "basin-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "packageManager": "pnpm@11.5.1",
    "scripts": {
        "build:wasm": "wasm-pack build ../crates/basin-wasm --target web --out-name basin_wasm --out-dir ../../web/src/lib/basin-wasm",
        "dev": "pnpm run build:wasm && vitepress dev",
        "build": "pnpm run build:wasm && vitepress build && node scripts/build-markdown.mjs",
        "preview": "vitepress preview",
        "preview:worker": "wrangler dev",
        "deploy": "wrangler deploy",
        "deploy:check": "wrangler deploy --dry-run",
        "check": "pnpm run build:wasm && vue-tsc --noEmit",
        "test:competitors": "tsx --test scripts/collect-competitors.test.ts",
        "test:labels": "tsx --test scripts/line-labels.test.ts",
        "test:markdown": "node --test scripts/html-to-markdown.test.js worker/markdown-negotiation.test.js",
        "format": "biome check --write --linter-enabled=false . && prettier --write \"**/*.vue\"",
        "format:check": "biome check --linter-enabled=false . && prettier --check \"**/*.vue\"",
        "lint": "biome lint .",
        "check:snippets": "tsx scripts/check-snippets.ts",
        "collect:benchmarks": "tsx scripts/collect-benchmarks.ts",
        "collect:competitors": "tsx scripts/collect-competitors.ts",
        "collect:solvers": "tsx scripts/collect-solvers.ts"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.155",
        "@iconify-json/simple-icons": "^1.2.102",
        "@types/node": "^26.6.6",
        "@types/prismjs": "^1.26.6",
        "katex": "^0.19.1",
        "node-html-markdown": "^2.0.0",
        "parse5": "^8.1.1",
        "prettier": "^3.10.1",
        "prismjs": "^1.30.0",
        "shiki": "^4.6.0",
        "tailwindcss": "^4.3.5",
        "tslib": "^2.9.1",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "unplugin-icons": "^24.0.0",
        "wrangler": "^4.162.0",
        "vitepress": "1.6.4",
        "vue": "^3.5.0",
        "vue-tsc": "^3.2.0",
        "@mdit/plugin-katex": "1.2.0",
        "@tailwindcss/postcss": "^4.3.5",
        "postcss": "^8.5.0"
    }
}
