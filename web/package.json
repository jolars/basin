{
    "name": "basin-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.5.1",
    "scripts": {
        "build:wasm": "wasm-pack build ../crates/basin-wasm --target web --out-name basin_wasm --out-dir ../../web/src/lib/basin-wasm",
        "dev": "pnpm run build:wasm && vite dev",
        "build": "pnpm run build:wasm && vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "biome check --write --linter-enabled=false . && prettier --write \"**/*.svelte\"",
        "format:check": "biome check --linter-enabled=false . && prettier --check \"**/*.svelte\"",
        "lint": "biome lint .",
        "check:snippets": "tsx scripts/check-snippets.ts",
        "collect:benchmarks": "tsx scripts/collect-benchmarks.ts",
        "collect:competitors": "tsx scripts/collect-competitors.ts",
        "collect:solvers": "tsx scripts/collect-solvers.ts"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.120",
        "@iconify-json/simple-icons": "^1.2.92",
        "@sveltejs/adapter-static": "^3.0.0",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.1.2",
        "@types/prismjs": "^1.26.6",
        "mdsvex": "^0.12.8",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prismjs": "^1.30.0",
        "shiki": "^4.3.1",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.4",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.6.0",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "unplugin-icons": "^23.0.1",
        "vite": "^8.1.5",
        "vite-plugin-wasm": "^3.4.0"
    }
}
