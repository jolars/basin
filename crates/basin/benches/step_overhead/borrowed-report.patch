+    #[doc(hidden)]
+    pub fn step_borrowed(
+        &mut self,
+    ) -> Result<Option<&TerminationReport<S::Float>>, So::Error> {
+        if self.finished.is_none() {
+            if let StepOutcome::Stopped(report) = self.step_active::<false>()? {
+                self.finished = Some(report);
+            }
+        }
+        Ok(self.finished.as_ref())
+    }
