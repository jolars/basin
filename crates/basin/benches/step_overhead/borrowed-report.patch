+#[test]
+fn borrowed_stop_report_is_stored_and_moved_once() {
+    let finals = Rc::new(RefCell::new(0));
+    let output = finals.clone();
+    let mut stepper = Executor::new(
+        Fit,
+        LevenbergMarquardtQr::<Vec<f64>, DenseMatrix>::new(),
+        PointState::new(vec![1.]),
+    )
+    .observe_solver(
+        move |_, _, event| {
+            if matches!(event, ObservationEvent::Final(_)) {
+                *output.borrow_mut() += 1;
+            }
+        },
+        ObserverMode::Always,
+    )
+    .into_stepper()
+    .unwrap();
+    let report = stepper.step_borrowed().unwrap().unwrap();
+    let report_address = std::ptr::from_ref(report);
+    let Termination::Converged(convergence) = &report.termination else {
+        panic!("expected convergence");
+    };
+    let allocation = convergence.criteria().as_ptr();
+    assert_eq!(
+        std::ptr::from_ref(stepper.finished().unwrap()),
+        report_address
+    );
+    assert_eq!(
+        std::ptr::from_ref(stepper.step_borrowed().unwrap().unwrap()),
+        report_address,
+    );
+    let result = stepper.run_to_end().unwrap();
+    let Termination::Converged(convergence) = &result.report.termination else {
+        panic!("expected convergence");
+    };
+    assert_eq!(convergence.criteria().as_ptr(), allocation);
+    assert_eq!(*finals.borrow(), 1);
+}
