+/// Experimental step outcome without ownership of the state.
+#[doc(hidden)]
+pub struct StepDecision<F: Scalar> {
+    pub completed: bool,
+    pub termination: Option<Termination<F>>,
+}
+
+impl<F: Scalar> StepDecision<F> {
+    pub fn new(completed: bool, termination: Option<Termination<F>>) -> Self {
+        Self {
+            completed,
+            termination,
+        }
+    }
+
+    pub fn completed() -> Self {
+        Self::new(true, None)
+    }
+
+    pub fn stopped(termination: Termination<F>) -> Self {
+        Self::new(false, Some(termination))
+    }
+
+    pub fn completed_with_termination(termination: Termination<F>) -> Self {
+        Self::new(true, Some(termination))
+    }
+
+    pub fn with_state<S: State<Float = F>>(self, state: S) -> SolverStep<S> {
+        SolverStep::new(state, self.completed, self.termination)
+    }
+}
